# =========================================================================
# Flora Workspace — Environment Configuration Template
# Copy this file to `.env` and fill in your values.
# All settings can also be set via environment variables prefixed with FLORA_
# =========================================================================

# --- Application ---
FLORA_ENV=development
FLORA_BASE_URL=http://localhost:3000
FLORA_HOST=0.0.0.0
FLORA_PORT=3000
FLORA_JWT_SECRET=change-me-to-a-random-secret-at-least-32-characters-long
FLORA_SESSION_TTL_SECS=3600

# --- Database (PostgreSQL) ---
FLORA_DATABASE__POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/flora

# --- Messaging (Valkey/Redis) ---
FLORA_MESSAGING__VALKEY_URL=redis://localhost:6379

# --- OIDC / Zitadel ---
# Replace with your Zitadel instance details.
OIDC_ISSUER_URL=http://localhost:8080
ZITADEL_ISSUER_URL=http://localhost:8080
ZITADEL_CLIENT_ID=flora@localhost
ZITADEL_CLIENT_SECRET=your-zitadel-client-secret
FLORA_OIDC__REDIRECT_URI=http://localhost:3000/auth/callback

# --- Search (Meilisearch) ---
# Required for T079 (Global Search). Optional for MVP.
# FLORA_SEARCH__MEILISEARCH_URL=http://localhost:7700
# FLORA_SEARCH__MEILISEARCH_KEY=your-meilisearch-master-key

# --- Storage ---
# Local filesystem path for file uploads (development).
# In production, replace with S3-compatible storage (T015).
FLORA_STORAGE__LOCAL_PATH=/var/flora/storage

# --- OpenTelemetry (optional) ---
# FLORA_OTEL_ENABLED=true
# FLORA_OTEL_ENDPOINT=http://localhost:4317
