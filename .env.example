# =========================================================================
# Flora Workspace — Environment Configuration Template
# Copy this file to `.env` and fill in your values.
# Configuration loads defaults and FLORA_* env vars (nested keys use "__").
# Some legacy flat vars are also read directly by defaults for compatibility.
# =========================================================================

# --- Application ---
FLORA_ENV=development
FLORA_BASE_URL=http://localhost:3000
FLORA_HOST=0.0.0.0
FLORA_PORT=3000
# Preferred/compatible JWT secret var (also read by defaults):
FLORA_JWT_SECRET=change-me-to-a-random-secret-at-least-32-characters-long
# Canonical nested keys (016-C):
FLORA_APP__ENV=development
FLORA_APP__HOST=0.0.0.0
FLORA_APP__PORT=3000
FLORA_APP__BASE_URL=http://localhost:3000
FLORA_APP__JWT_SECRET=change-me-to-a-random-secret-at-least-32-characters-long
FLORA_APP__SESSION_TTL_SECS=3600

# --- Database (PostgreSQL, required) ---
FLORA_DATABASE__POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/flora
# Conservative pool defaults for Seed/VPS (~2 vCPU/4GB); tune per workload.
FLORA_DATABASE__MAX_CONNECTIONS=10
FLORA_DATABASE__MIN_CONNECTIONS=2
FLORA_DATABASE__ACQUIRE_TIMEOUT_SECS=30
FLORA_DATABASE__IDLE_LIFETIME_SECS=600

# --- Administrator password recovery (TEMPORARY — remove after use) ---
# When BOTH variables are set, the API overwrites the password hash of this
# EXISTING administrator on EVERY startup, even if a password is already set.
# Use only to recover local access: after logging in, REMOVE both variables
# from your environment/.env and restart so the secret is not reapplied.
# Never commit real values. The password is validated (15..1024 chars) but
# never logged.
# Exact e-mail (preferred when the administrator address is known):
# FLORA_BOOTSTRAP__ADMIN_EMAIL=luis.granja@mdmv.com.br
# Explicit, TEMPORARY recovery when the address is unknown: set ADMIN_EMAIL to
# exactly `*` to apply the password to the FIRST ACTIVE user (oldest by
# created_at). There is no admin-role filter: confirm which account received
# the password, then REMOVE both variables and restart immediately.
# FLORA_BOOTSTRAP__ADMIN_EMAIL=*
# FLORA_BOOTSTRAP__ADMIN_PASSWORD=change-me-to-a-temporary-strong-password

# CORS: exact browser/webview origins, Figment array syntax (double quotes inside;
# no "*"). `localhost` and `127.0.0.1` are distinct origins; include both forms.
# Export into the PROCESS ENVIRONMENT (shell export, systemd, docker env_file);
# this checkout has no Rust code that auto-loads `.env`.
FLORA_APP__CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173"]
# Future Tauri webview origins — add only after a real Windows smoke:
#   "tauri://localhost"  (macOS / Linux / iOS)
#   "http://tauri.localhost"  (Windows / Android)
# Never add "null" (opaque origin) and never add "*".

# --- Messaging (Valkey/Redis, optional; lean core can disable) ---
FLORA_MESSAGING__ENABLED=false
FLORA_MESSAGING__VALKEY_URL=redis://localhost:6379

# --- Search (023: Postgres FTS is authoritative on ALL profiles) ---
# Meilisearch is a dormant, non-authoritative capability for a future gated
# re-enablement (it currently has no mutation-indexing hooks or rebuild tool).
# Enabling it does NOT change `/api/v1/search`, which always answers from Postgres.
FLORA_SEARCH__ENABLED=false
FLORA_SEARCH__URL=http://localhost:7700
# FLORA_SEARCH__API_KEY=dev-meilisearch-master-key
# FLORA_SEARCH__DEFAULT_LIMIT=20
# FLORA_SEARCH__MAX_LIMIT=100
# FLORA_SEARCH__INDEX_TEMPLATE=flora_org_{org_id}
# Legacy fallbacks still read by the code when the FLORA_* keys are absent:
# MEILISEARCH_URL / MEILISEARCH_API_KEY

# --- OIDC / Zitadel (optional for local dev flows; provider-specific) ---
FLORA_OIDC__ISSUER_URL=http://localhost:8080
FLORA_OIDC__CLIENT_ID=flora@localhost
FLORA_OIDC__CLIENT_SECRET=your-zitadel-client-secret
# Extra redirect URIs for /api/v1/auth/login: Figment array syntax (double quotes
# inside). Exact match; the callback from FLORA_APP__BASE_URL is always allowed.
# FLORA_OIDC__ALLOWED_REDIRECT_URIS=["http://127.0.0.1:4173/callback"]
# Legacy fallbacks read by OidcConfig::default() via std::env::var:
# ZITADEL_ISSUER_URL=http://localhost:8080
# ZITADEL_CLIENT_ID=flora@localhost
# ZITADEL_CLIENT_SECRET=your-zitadel-client-secret

# --- Storage ---
# Local filesystem path for file uploads (development/Seed).
FLORA_STORAGE__LOCAL_PATH=/var/flora/storage

# --- OpenTelemetry (optional) ---
# FLORA_APP__OTEL_ENABLED=true
# FLORA_APP__OTEL_ENDPOINT=http://localhost:4317

# --- Notes (016-C) ---
# - Lean Seed profile: postgres + api only (search/messaging disabled).
# - Enable optional services via compose profiles (`--profile realtime`, `--profile search`) and matching FLORA_*__ENABLED flags.
# - SQLite runtime path is not supported by the API (PostgreSQL required).

# --- Frontend runtime config (rendered into static/config.js at deploy) ---
# PUBLIC_API_BASE_URL=https://flora.example.com
# PUBLIC_WS_BASE_URL=wss://flora.example.com
# These are injected as window.__FLORA_CONFIG__ BEFORE the app bundle; they win over
# VITE_API_URL (build-time fallback only). Leave wsBaseUrl empty to derive from API base.
