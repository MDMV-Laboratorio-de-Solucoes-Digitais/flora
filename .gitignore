# =========================================================================
# FLORA WORKSPACE - ROOT .GITIGNORE
# =========================================================================

# -------------------------------------------------------------------------
# ENVIRONMENT VARIABLES & SECRETS
# -------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.cert

# -------------------------------------------------------------------------
# RUST & CARGO
# -------------------------------------------------------------------------
# Build artifacts
target/
**/target/
!src-tauri/target/

# Backup files generated by rustfmt
**/*.rs.bk

# Cargo workspace specific
Cargo.toml.orig
Cargo.lock.orig

# -------------------------------------------------------------------------
# SQLX & SQLITE FALLBACKS
# -------------------------------------------------------------------------
# Local SQLite database files used for offline/local development
*.db
*.db3
*.sqlite
*.sqlite3
*.db-shm
*.db-wal

# NOTE: The .sqlx/ directory is explicitly NOT ignored so `cargo sqlx prepare`
# artifacts can be committed to run CI/CD without an active database.

# -------------------------------------------------------------------------
# FRONTEND (NODE / BUN / SOLIDJS / SVELTE)
# -------------------------------------------------------------------------
# Dependencies
node_modules/
jspm_packages/

# Bun specific
.bun/
bun.lockb

# Build outputs & caches
dist/
dist-ssr/
build/
.svelte-kit/
.output/
.vercel/
.netlify/
.vite/
.rollup.cache/

# Logs and debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.eslintcache

# -------------------------------------------------------------------------
# TAURI & MOBILE (ANDROID / IOS)
# -------------------------------------------------------------------------
# Tauri builds are handled by Rust's /target/, but we ignore specific
# mobile artifacts for future-proofing Tauri v2 mobile deployments.

# Android
.gradle/
app/build/
local.properties
*.apk
*.aab
*.jks

# iOS
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
DerivedData/
*.mobileprovision
*.cert

# -------------------------------------------------------------------------
# SYSTEM / OS RELATED
# -------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes
.AppleDB
.AppleDesktop
Network\ Trash\ Folder/
Mac\ OS\ X\ Formats/

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# -------------------------------------------------------------------------
# IDEs & EDITORS
# -------------------------------------------------------------------------
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# IntelliJ / JetBrains
.idea/
*.iml
*.iws

# Zed & Fleet
.zed/
.fleet/

# Vim / Emacs
*.swp
*.swo
*~
